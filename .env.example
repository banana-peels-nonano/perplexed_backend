# Copy to .env (cp .env.example .env), fill in, then: chmod 600 .env
# .env must never be committed. .env.example (no secrets) should be.

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Same password as above. asyncpg is the async driver SQLAlchemy will use.
DATABASE_URL=postgresql+asyncpg://perplexed:change-me-to-a-long-random-string@127.0.0.1:5432/perplexed
TEST_DATABASE_URL=postgresql+asyncpg://perplexed:change-me-to-a-long-random-string@127.0.0.1:5432/perplexed_test

# Use the DEV key here. Keep the event key out of your laptop until deploy day.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Organiser API. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to switch the organiser API off. Different value on the event server.
ADMIN_TOKEN=

# Email for team registration. Empty SMTP_HOST = no mail: teams still register and the
# console shows "not_configured"; organisers resend once it's set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_URL=
