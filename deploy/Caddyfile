# DOMAIN=perplexed.example.org: Caddy gets and renews the HTTPS certificate by itself (the
# domain's A record must point at this server, ports 80 and 443 open).
# DOMAIN=:80 : plain http on the server's IP, no certificate (until the domain exists).
# WebSockets pass through untouched either way.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB # organisers upload documents up to 15 MB (base64 adds a third)
	}
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
