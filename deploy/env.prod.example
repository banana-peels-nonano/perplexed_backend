# deploy/.env on the event server (setup.sh writes it). chmod 600. Never commit it.
DOMAIN=perplexed.example.org   # or :80 for plain http on the IP (no domain yet)
POSTGRES_PASSWORD=
ADMIN_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COOKIE_SECURE=true          # false only for a plain-http test on an IP address
BACKUP_EVERY_SECONDS=300
BACKUP_KEEP=288
# email for team registration (access codes go only to members' inboxes)
# Gmail: smtp.gmail.com, 587, the address, a 16-character app password (needs 2-step verification)
# Brevo: smtp-relay.brevo.com, 587, the SMTP login, an SMTP key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PERPLEXED 2.0 <someone@gmail.com>"
# the link put in emails, e.g. http://203.0.113.7/ now, https://<subdomain>/ later
PUBLIC_URL=
