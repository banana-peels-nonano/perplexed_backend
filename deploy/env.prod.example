# Copy to deploy/.env and chmod 600. Keep it out of git.
# Use a hexadecimal password so it can be included directly in DATABASE_URL.
POSTGRES_PASSWORD=
ADMIN_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COOKIE_SECURE=true
# Optional startup seed. Leave blank to seed manually on the first deploy.
SEED_CASE=
EVENT_NAME="PERPLEXED 2.0"
BACKUP_EVERY_SECONDS=300
BACKUP_KEEP=288
# email for team registration (access codes go only to members' inboxes)
# Gmail: smtp.gmail.com, 587, the address, a 16-character app password (needs 2-step verification)
# Brevo: smtp-relay.brevo.com, 587, the SMTP login, an SMTP key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PERPLEXED 2.0 <someone@gmail.com>"
# The public link included in registration emails.
PUBLIC_URL=https://perplexed.saturnalia.in/
